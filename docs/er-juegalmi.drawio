<mxCell id="n242" value="&lt;b&gt;JuegAlmi – Modelo relacional&lt;/b&gt; (v3, 2026-10-28, sin ciclos) · MariaDB · 17 tablas&lt;br&gt;&lt;u&gt;PK&lt;/u&gt; · FK → tabla (acción ON DELETE; ON UPDATE siempre RESTRICT) · UQ = único · ? = admite NULL · CHECK = regla en la BBDD · TRG = regla con trigger · Verde = tabla nueva" style="text;html=1;align=left;verticalAlign=top;fontSize=14;" vertex="1" parent="1">
<mxGeometry x="0" y="0" width="1700" height="50" as="geometry" />
</mxCell>
<mxCell id="n243" value="&lt;div style='background:#dae8fc;padding:4px;font-weight:bold;border-bottom:1px solid #6c8ebf'&gt;departamento&lt;/div&gt;&lt;div style='padding:4px'&gt;&lt;u&gt;PK id&lt;/u&gt;&lt;br&gt;nombre UQ: Telefonía | Consolas&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=0;fontSize=12;strokeColor=#6c8ebf;" vertex="1" parent="1">
<mxGeometry x="0" y="80" width="241" height="74" as="geometry" />
</mxCell>
