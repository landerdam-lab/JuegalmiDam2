<?xml version="1.0" encoding="utf-8"?>
<!-- Android 9+ bloquea el HTTP sin cifrar: la app de la entrega solo habla por HTTPS. El HTTP de
     desarrollo se permite únicamente en debug: src/debug/res/xml/network_security_config.xml. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
