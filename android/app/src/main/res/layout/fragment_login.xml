<?xml version="1.0" encoding="utf-8"?>
<!-- PT-02 Login · diseño design/screens/02-login-*.png -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/ja_espacio_4"
        android:paddingVertical="@dimen/ja_espacio_8">

        <include layout="@layout/cabecera_logo" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ja_espacio_8">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/ja_espacio_6">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/login_titulo"
                    android:textAppearance="@style/TextAppearance.JuegAlmi.TitularM"
                    android:textColor="@color/ja_texto" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilEmail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ja_espacio_5"
                    android:hint="@string/campo_email"
                    app:startIconDrawable="@drawable/ic_mail">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etEmail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:autofillHints="emailAddress"
                        android:inputType="textEmailAddress" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilPassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ja_espacio_3"
                    android:hint="@string/campo_password"
                    app:endIconMode="password_toggle"
                    app:startIconDrawable="@drawable/ic_lock">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etPassword"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:autofillHints="password"
                        android:imeOptions="actionDone"
                        android:inputType="textPassword" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Botón principal (el único amarillo de la pantalla) con su estado «cargando» -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ja_espacio_6">

                    <Button
                        android:id="@+id/btnEntrar"
                        style="@style/Widget.JuegAlmi.Boton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/login_entrar"
                        app:icon="@drawable/ic_arrow_forward"
                        app:iconGravity="textEnd"
                        app:iconTint="@color/ja_sobre_primario" />

                    <com.google.android.material.progressindicator.CircularProgressIndicator
                        android:id="@+id/progreso"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:elevation="@dimen/ja_elevacion_3"
                        android:indeterminate="true"
                        android:visibility="gone"
                        app:indicatorColor="@color/ja_sobre_primario"
                        app:indicatorSize="@dimen/ja_tamano_icono" />
                </FrameLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/ja_borde_fino"
                    android:layout_marginTop="@dimen/ja_espacio_6"
                    android:background="@color/ja_borde" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="@dimen/ja_espacio_2"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/login_sin_cuenta"
                        android:textAppearance="@style/TextAppearance.JuegAlmi.Cuerpo"
                        android:textColor="@color/ja_texto_2" />

                    <Button
                        android:id="@+id/btnIrRegistro"
                        style="@style/Widget.JuegAlmi.Boton.Texto"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/login_registrate" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="@dimen/ja_espacio_8" />

        <!-- Aviso de ubicación: se explica ANTES de pedir el permiso (DESIGN.md §10) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="@dimen/ja_tamano_icono_s"
                android:layout_height="@dimen/ja_tamano_icono_s"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_location_on"
                app:tint="@color/ja_texto_2" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ja_espacio_2"
                android:text="@string/login_aviso_ubicacion"
                android:textAppearance="@style/TextAppearance.JuegAlmi.EtiquetaS"
                android:textColor="@color/ja_texto_2" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
