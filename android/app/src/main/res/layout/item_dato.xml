<?xml version="1.0" encoding="utf-8"?>
<!-- Un dato de la ficha: etiqueta pequeña encima y valor debajo (Género / Aventura) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingVertical="@dimen/ja_espacio_2">

    <TextView
        android:id="@+id/tvEtiqueta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.JuegAlmi.Cuerpo"
        android:textColor="@color/ja_texto_2" />

    <TextView
        android:id="@+id/tvValor"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.JuegAlmi.Subtitulo"
        android:textColor="@color/ja_texto" />
</LinearLayout>
