<?xml version="1.0" encoding="utf-8"?>
<!-- Plantilla de las listas del cliente: Mis pedidos (PT-13), Mis alquileres (PT-16) y Mis reparaciones (PT-18).
     Título + filtros (chips o pestañas) + lista + estados de carga, vacío y error + FAB opcional. -->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvTitulo"
            style="@style/JuegAlmi.TituloPantalla"
            android:layout_marginTop="0dp"
            android:paddingHorizontal="@dimen/ja_espacio_4" />

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/pestanas"
            style="@style/Widget.JuegAlmi.Pestanas"
            android:layout_width="match_parent"
            android:layout_height="@dimen/ja_tamano_barra_pestanas"
            android:visibility="gone"
            app:tabMode="fixed" />

        <HorizontalScrollView
            android:id="@+id/scrollChips"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ja_espacio_2"
            android:paddingHorizontal="@dimen/ja_espacio_4"
            android:clipToPadding="false"
            android:scrollbars="none"
            android:visibility="gone">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:selectionRequired="true"
                app:singleLine="true"
                app:singleSelection="true" />
        </HorizontalScrollView>

        <TextView
            android:id="@+id/tvResultados"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/ja_espacio_4"
            android:layout_marginVertical="@dimen/ja_espacio_2"
            android:textAppearance="@style/TextAppearance.JuegAlmi.EtiquetaS"
            android:textColor="@color/ja_texto_2" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- Tirar hacia abajo recarga la lista (igual que el ion-refresher de Ionic) -->
            <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
                android:id="@+id/refresco"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/lista"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:paddingHorizontal="@dimen/ja_espacio_4"
                    android:paddingBottom="@dimen/lista_hueco_fab" />
            </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/progreso"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:indeterminate="true"
                android:visibility="gone"
                app:indicatorColor="@color/ja_marca" />

            <include
                layout="@layout/estado_vacio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center" />
        </FrameLayout>
    </LinearLayout>

    <!-- FAB extendido amarillo con muesca de 12 (DESIGN.md §9). Solo en Mis reparaciones -->
    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="@dimen/ja_espacio_4"
        android:textAppearance="@style/TextAppearance.JuegAlmi.Etiqueta"
        android:textColor="@color/ja_sobre_primario"
        android:visibility="gone"
        app:backgroundTint="@color/ja_primario"
        app:iconTint="@color/ja_sobre_primario"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.JuegAlmi.MuescaFab" />
</androidx.coordinatorlayout.widget.CoordinatorLayout>
