<?xml version="1.0" encoding="utf-8"?>
<!-- PT-04 Inicio: buscador con micro (voz, PT-29) + pestañas Videojuegos · Móviles y tablets · Consolas.
     Cada pestaña es el catálogo de su tipo (PT-05, PT-07, PT-09). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/ja_tamano_campo_alto"
        android:layout_marginHorizontal="@dimen/ja_espacio_4"
        android:layout_marginBottom="@dimen/ja_espacio_2"
        android:background="@drawable/fondo_buscador"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/ja_espacio_4"
        android:paddingEnd="@dimen/ja_espacio_1">

        <ImageView
            android:layout_width="@dimen/ja_tamano_icono"
            android:layout_height="@dimen/ja_tamano_icono"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_search"
            app:tint="@color/ja_texto_2" />

        <EditText
            android:id="@+id/etBuscar"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/ja_espacio_3"
            android:layout_weight="1"
            android:background="@null"
            android:hint="@string/buscar_pista"
            android:imeOptions="actionSearch"
            android:importantForAutofill="no"
            android:inputType="text"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.JuegAlmi.Cuerpo"
            android:textColor="@color/ja_texto"
            android:textColorHint="@color/ja_texto_3" />

        <ImageButton
            android:id="@+id/btnVoz"
            android:layout_width="@dimen/ja_tamano_tactil_min"
            android:layout_height="@dimen/ja_tamano_tactil_min"
            android:background="@drawable/fondo_micro"
            android:contentDescription="@string/buscar_voz"
            android:src="@drawable/ic_mic"
            app:tint="@color/ja_sobre_primario" />
    </LinearLayout>

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/pestanas"
        style="@style/Widget.JuegAlmi.Pestanas"
        android:layout_width="match_parent"
        android:layout_height="@dimen/ja_tamano_barra_pestanas"
        app:tabGravity="start"
        app:tabMode="scrollable" />

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/ja_borde_fino"
        android:background="@color/ja_borde" />

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/paginas"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
