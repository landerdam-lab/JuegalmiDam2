<?xml version="1.0" encoding="utf-8"?>
<!-- Estado vacío / error / sin conexión (diseño e1): baldosa de 96 con muesca + título + texto + 1 botón.
     Lo maneja ui/comun/EstadoVista. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/estado"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="@dimen/ja_espacio_6"
    android:visibility="gone">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/estadoIcono"
        android:layout_width="@dimen/estado_baldosa"
        android:layout_height="@dimen/estado_baldosa"
        android:background="@color/ja_primario"
        android:padding="@dimen/estado_icono_relleno"
        android:src="@drawable/ic_inventory_2"
        app:shapeAppearance="@style/ShapeAppearance.JuegAlmi.Muesca"
        app:tint="@color/ja_sobre_primario" />

    <TextView
        android:id="@+id/estadoTitulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ja_espacio_4"
        android:gravity="center"
        android:textAppearance="@style/TextAppearance.JuegAlmi.Titulo"
        android:textColor="@color/ja_texto" />

    <TextView
        android:id="@+id/estadoTexto"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ja_espacio_2"
        android:gravity="center"
        android:textAppearance="@style/TextAppearance.JuegAlmi.Cuerpo"
        android:textColor="@color/ja_texto_2" />

    <Button
        android:id="@+id/estadoBoton"
        style="@style/Widget.JuegAlmi.Boton.Secundario"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ja_espacio_4"
        android:text="@string/reintentar" />
</LinearLayout>
