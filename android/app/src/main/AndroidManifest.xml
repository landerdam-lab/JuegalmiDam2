<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />

    <application
        android:name=".JuegAlmiApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_logo"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_logo"
        android:supportsRtl="true"
        android:theme="@style/Theme.AlmiCompanion.Splash">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.auth.AuthActivity"
            android:exported="false"
            android:theme="@style/Theme.JuegAlmi"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.detalle.DetalleProductoActivity"
            android:exported="false"
            android:theme="@style/Theme.JuegAlmi" />

        <activity
            android:name=".ui.pedidos.ConfirmarPedidoActivity"
            android:exported="false"
            android:theme="@style/Theme.JuegAlmi" />
        <activity
            android:name=".ui.pedidos.PedidoRealizadoActivity"
            android:exported="false"
            android:theme="@style/Theme.JuegAlmi" />
        <activity
            android:name=".ui.pedidos.DetallePedidoActivity"
            android:exported="false"
            android:theme="@style/Theme.JuegAlmi" />

        <activity
            android:name=".ui.reparaciones.NuevaReparacionActivity"
            android:exported="false"
            android:theme="@style/Theme.JuegAlmi"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.tienda.ServiciosActivity"
            android:exported="false"
            android:theme="@style/Theme.JuegAlmi" />
        <activity
            android:name=".ui.tienda.UbicacionActivity"
            android:exported="false"
            android:theme="@style/Theme.JuegAlmi" />
        <activity
            android:name=".ui.tienda.GaleriaActivity"
            android:exported="false"
            android:theme="@style/Theme.JuegAlmi" />
        <activity
            android:name=".ui.tienda.HistoriaActivity"
            android:exported="false"
            android:theme="@style/Theme.JuegAlmi" />

        <service
            android:name=".data.FotoService"
            android:exported="false"
            android:process=":fotos" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fotos"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/rutas_fotos" />
        </provider>
    </application>

</manifest>
