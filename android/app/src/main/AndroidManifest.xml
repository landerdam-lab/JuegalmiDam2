<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Ubicación aproximada (wifi/red móvil) y precisa (GPS): cabeceras X-Latitud / X-Longitud (ADR-014) -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- El tema de la app es el splash (PT-01, con el logo de Almi Companion): MainActivity pasa a Theme.JuegAlmi al arrancar.
         networkSecurityConfig: HTTP solo para la API de desarrollo, mientras no haya HTTPS (A-32) -->
    <!-- JuegAlmiApp: aplica el tema elegido y configura OSMDroid antes de abrir ninguna pantalla -->
    <application
        android:name=".JuegAlmiApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_logo"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_logo"
        android:supportsRtl="true"
        android:theme="@style/Theme.AlmiCompanion.Splash">
        <!-- singleTop: «Ver carrito» desde la ficha reutiliza esta pantalla en vez de abrir otra -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Login (PT-02) y Registro (PT-03). adjustResize: el teclado no tapa los campos -->
        <activity
            android:name=".ui.auth.AuthActivity"
            android:exported="false"
            android:theme="@style/Theme.JuegAlmi"
            android:windowSoftInputMode="adjustResize" />

        <!-- Ficha de producto (PT-06, PT-08, PT-10) -->
        <activity
            android:name=".ui.detalle.DetalleProductoActivity"
            android:exported="false"
            android:theme="@style/Theme.JuegAlmi" />

        <!-- Pedido: confirmar (PT-12), realizado (PT-12b) y detalle (PT-14) -->
        <activity
            android:name=".ui.pedidos.ConfirmarPedidoActivity"
            android:exported="false"
            android:theme="@style/Theme.JuegAlmi" />
        <activity
            android:name=".ui.pedidos.PedidoRealizadoActivity"
            android:exported="false"
            android:theme="@style/Theme.JuegAlmi" />
        <activity
            android:name=".ui.pedidos.DetallePedidoActivity"
            android:exported="false"
            android:theme="@style/Theme.JuegAlmi" />

        <!-- Solicitar reparación (PT-17) -->
        <activity
            android:name=".ui.reparaciones.NuevaReparacionActivity"
            android:exported="false"
            android:theme="@style/Theme.JuegAlmi"
            android:windowSoftInputMode="adjustResize" />

        <!-- La tienda: Servicios (PT-25), Ubicación (PT-26), Galería (PT-27) e Historia (PT-28) -->
        <activity
            android:name=".ui.tienda.ServiciosActivity"
            android:exported="false"
            android:theme="@style/Theme.JuegAlmi" />
        <activity
            android:name=".ui.tienda.UbicacionActivity"
            android:exported="false"
            android:theme="@style/Theme.JuegAlmi" />
        <activity
            android:name=".ui.tienda.GaleriaActivity"
            android:exported="false"
            android:theme="@style/Theme.JuegAlmi" />
        <activity
            android:name=".ui.tienda.HistoriaActivity"
            android:exported="false"
            android:theme="@style/Theme.JuegAlmi" />

        <!-- Comparte con la app de cámara el fichero donde guardar la foto (util/Camara) -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fotos"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/rutas_fotos" />
        </provider>
    </application>

</manifest>
