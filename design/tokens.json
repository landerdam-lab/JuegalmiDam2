  "muesca": {
    "$description": "La firma visual: esquina superior derecha cortada a 45°, como un cartucho, una tarjeta SD o una SIM (las tres líneas de negocio). Android: cornerFamily=cut en la esquina superior derecha. Ionic: clip-path.",
    "tarjeta": 16,
    "destacada": 24,
    "chip-precio": 6,
    "boton": 0
  },
  "elevacion": {
    "0": {
      "android": 0,
      "css": "none"
    },
    "1": {
      "android": 1,
      "css": "0 1px 2px rgba(28,21,48,.08), 0 1px 3px rgba(28,21,48,.06)"
    },
    "2": {
      "android": 3,
      "css": "0 2px 6px rgba(28,21,48,.10), 0 4px 12px rgba(28,21,48,.06)"
    },
    "3": {
      "android": 8,
      "css": "0 8px 24px rgba(28,21,48,.16)"
    },
    "$description": "Claro: sombra suave. Oscuro: sin sombra, se sube un nivel de superficie (superficie → superficie-2).",
    "muesca": {
      "android": 3,
      "css": "drop-shadow(0 2px 6px rgba(28,21,48,.10))",
      "$description": "Sombra para elementos con muesca (clip-path recorta box-shadow): se aplica como filter en un contenedor"
    }
  },
